Bootstrap: docker
From: ubuntu:24.04

# UNTESTED first draft. Expect to tweak versions on the first build.
# Only dependencies live in the image. Code, data, weights and caches are bind-mounted at runtime.
# Ubuntu 24.04 ships Python 3.12. PyTorch cu126 wheels bundle the CUDA runtime, so no CUDA toolkit
# is needed in the image; the host NVIDIA driver is injected with `apptainer exec --nv`.

%labels
    Project eecs542tbn
    Name promptcorrect

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip \
        git build-essential ca-certificates curl libgl1 libglib2.0-0
    rm -rf /var/lib/apt/lists/*

    python3 -m venv /opt/venv
    . /opt/venv/bin/activate
    pip install --no-cache-dir --upgrade pip wheel setuptools

    # Torch version follows the SAM 3 README (check it; bump here if it changes).
    pip install --no-cache-dir torch==2.7.0 torchvision==0.22.0 \
        --index-url https://download.pytorch.org/whl/cu126

    # SAM 3. Pin a commit here once the smoke test passes, for reproducibility.
    git clone https://github.com/facebookresearch/sam3.git /opt/sam3
    cd /opt/sam3
    pip install --no-cache-dir -e .

    # SAM 2.1 (fallback segmenter). Skip the optional CUDA extension build (no nvcc in the image).
    SAM2_BUILD_CUDA=0 pip install --no-cache-dir "git+https://github.com/facebookresearch/sam2.git"

    # Project dependencies
    # Version bounds must match pyproject.toml (transformers 5 breaks P2's Grounding DINO code).
    pip install --no-cache-dir \
        "numpy>=1.26,<3" "scipy>=1.11" "pyyaml>=6,<7" "pycocotools>=2.0.7,<3" "Pillow>=10,<13" \
        "pandas>=2.1" "pyarrow>=14" "transformers>=4.51,<5" "huggingface_hub>=0.23" "safetensors>=0.4" \
        "pytest>=8,<10" lvis opencv-python-headless scikit-image matplotlib tqdm accelerate timm einops

%test
    python -c "import torch, pycocotools, cv2; print('torch', torch.__version__)"
